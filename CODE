#include <pic.h>

#define RS RC0
#define RW RC1
#define EN RC2

char byte;

/* Timer0 based delay */
void delay()
{
    T0CS = 0;
    T0SE = 0;

    PSA = 0;
    PS2 = 1;
    PS1 = 1;
    PS0 = 1;

    TMR0 = 252;

    while(TMR0IF == 0);

    TMR0IF = 0;
    TMR0 = 0;
}

void delay1(unsigned int x)
{
    for(int i = 0; i < x; i++)
    {
        delay();
    }
}

void lcd_command(unsigned char con)
{
    PORTB = con;
    RS = 0;
    RW = 0;
    EN = 1;
    delay1(1);
    EN = 0;
}

void lcd_data(unsigned char data)
{
    PORTB = data;
    RS = 1;
    RW = 0;
    EN = 1;
    delay1(1);
    EN = 0;
}

void lcd_init()
{
    lcd_command(0x38);     // 8-bit mode, 2 lines
    lcd_command(0x06);     // Auto-increment cursor
    lcd_command(0x0C);     // Display ON, Cursor OFF
    lcd_command(0x01);     // Clear screen
    delay1(5);
}

void lcd_display(const char *m)
{
    for(int i = 0; m[i] != '\0'; i++)
    {
        lcd_data(m[i]);
    }
}

/* Helper to convert multi-digit numbers to ASCII on LCD */
void lcd_display_number(unsigned int num)
{
    char buffer[5];
    int i = 0;

    if (num == 0) {
        lcd_data('0');
        return;
    }

    while (num > 0) {
        buffer[i++] = (num % 10) + '0';
        num /= 10;
    }

    while (--i >= 0) {
        lcd_data(buffer[i]);
    }
}

void write(unsigned char data, unsigned char addr)
{
    EEADR = addr;
    EEDATA = data;

    EEPGD = 0;       // Data EEPROM select
    WREN = 1;        // Enable writes

    EECON2 = 0x55;   // Unlock sequence
    EECON2 = 0xAA;

    WR = 1;          // Start write

    while(EEIF == 0);
    EEIF = 0;
    WREN = 0;
}

void read(unsigned char addr)
{
    EEADR = addr;
    EEPGD = 0;
    RD = 1;
    byte = EEDATA;
}

void main()
{
    int arr[4]; // Corrected array size
    int a = 0, b = 0, c = 0, d = 0;
    int winner_idx = 0;

    PORTB = 0x00;
    TRISB = 0x00;

    PORTC = 0x00;
    TRISC = 0x08;   // RC3 as Input

    PORTD = 0x00;
    TRISD = 0x0F;   // RD0-RD3 as Inputs

    lcd_init();

    while(1)
    {
        /* Voting Mode */
        if(RC3 == 0)
        {
            lcd_command(0x80);
            lcd_display("VOTING MACHINE ");

            /* Candidate 1 */
            if(RD0 == 1)
            {
                RD4 = 1;
                a++;
                write(a, 0xC0);

                lcd_command(0x01);
                lcd_command(0x80);
                lcd_display("Processing...");
                delay1(300);

                lcd_command(0xC0);
                lcd_display("Voted: Candidate 1");
                
                while(RD0 == 1); // Debounce: wait for button release
                delay1(400);
                lcd_command(0x01);
                RD4 = 0;
            }

            /* Candidate 2 */
            if(RD1 == 1)
            {
                RD5 = 1;
                b++;
                write(b, 0xC1);

                lcd_command(0x01);
                lcd_command(0x80);
                lcd_display("Processing...");
                delay1(300);

                lcd_command(0xC0);
                lcd_display("Voted: Candidate 2");

                while(RD1 == 1); // Wait for release
                delay1(400);
                lcd_command(0x01);
                RD5 = 0;
            }

            /* Candidate 3 */
            if(RD2 == 1)
            {
                RD6 = 1;
                c++;
                write(c, 0xC2);

                lcd_command(0x01);
                lcd_command(0x80);
                lcd_display("Processing...");
                delay1(300);

                lcd_command(0xC0);
                lcd_display("Voted: Candidate 3");

                while(RD2 == 1); // Wait for release
                delay1(400);
                lcd_command(0x01);
                RD6 = 0;
            }

            /* Candidate 4 */
            if(RD3 == 1)
            {
                RD7 = 1;
                d++;
                write(d, 0xC3);

                lcd_command(0x01);
                lcd_command(0x80);
                lcd_display("Processing...");
                delay1(300);

                lcd_command(0xC0);
                lcd_display("Voted: Candidate 4");

                while(RD3 == 1); // Wait for release
                delay1(400);
                lcd_command(0x01);
                RD7 = 0;
            }
        }

        /* Result Mode */
        if(RC3 == 1)
        {
            lcd_command(0x01);
            lcd_command(0x80);
            lcd_display("RESULTS RELEASED");
            delay1(1000);

            const char* names[4] = {"VK ", "AK ", "SK ", "VKY"};
            unsigned char addrs[4] = {0xC0, 0xC1, 0xC2, 0xC3};

            /* Read and Display Votes */
            for(int i = 0; i < 4; i++)
            {
                read(addrs[i]);
                arr[i] = byte;

                lcd_command(0x01);
                lcd_command(0x80);
                lcd_display(names[i]);
                lcd_display(" Votes: ");
                lcd_display_number(arr[i]);

                delay1(1200);
            }

            /* Calculate Winner */
            int max_votes = arr[0];
            winner_idx = 0;

            for(int i = 1; i < 4; i++)
            {
                if(arr[i] > max_votes)
                {
                    max_votes = arr[i];
                    winner_idx = i;
                }
            }

            /* Display Winner */
            lcd_command(0x01);
            lcd_command(0x80);
            lcd_display("WINNER IS:");
            lcd_command(0xC0);
            lcd_display(names[winner_idx]);

            delay1(2000);
        }
    }
}
